# Credentials for `npm run sign`, which is what hands the package to AMO to be
# signed. Copy this file to `.env` - that one is gitignored - and paste in the
# pair generated at https://addons.mozilla.org/developers/addon/api/key/
#
# Nothing else reads these, and nothing else in the extension ever talks to a
# server: signing is a build-time act, not something the add-on does.

# JWT issuer, of the form user:12345678:123
WEB_EXT_API_KEY=

# JWT secret, a long hex string. AMO shows it exactly once - if it is lost,
# revoke the key on that page and generate a new one rather than looking for it.
WEB_EXT_API_SECRET=
